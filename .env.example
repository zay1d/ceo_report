# Скопируйте в .env и заполните. Файл .env в git не попадает.
TCM_SHEET_ID=1TUUJideNhLcJtSS4LtEbyhgtIFw-dUx7hzJIjntWqP4
# Только для варианта со своим доменом и Caddy (при Tailscale не нужен)
TCM_DOMAIN=
# Ключ сервисного аккаунта: файл secrets/sa.json (путь задаётся в docker-compose / systemd)
# Логины и хэши паролей: python -m tcm.auth <пароль>
TCM_USERS=ceo:scrypt.….…
# Случайная строка ≥32 символов: python -c "import secrets;print(secrets.token_hex(32))"
TCM_SECRET=
TCM_CACHE_MIN=15
# Папка для комментариев (comments.json); сервис должен иметь право записи. Пусто — комментарии выключены.
# В docker-compose задана сама (том state), в systemd — /opt/tcm-analytics/state
TCM_STATE_DIR=
# Логины с ролью «ответственный» через запятую: им не виден комментарий руководства. Остальные — «руководство».
TCM_MANAGERS=
TCM_COOKIE_SECURE=1
# MallSense — трафик ТРЦ и зон по счётчикам. Пусто — трафик из вкладки «Заполняемость Mall».
# Те же ключи, что в /opt/mallsense-report/.env на ВМ (лучше выпустить отдельный токен в кабинете MallSense).
MALLSENSE_XTOKEN=
MALLSENSE_APP_KEY=
