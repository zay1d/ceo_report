# Скопируйте в .env и заполните. Файл .env в git не попадает.
TCM_SHEET_ID=1TUUJideNhLcJtSS4LtEbyhgtIFw-dUx7hzJIjntWqP4
# Путь к JSON-ключу сервисного аккаунта внутри контейнера (см. docker run -v ниже)
TCM_SA_KEY_FILE=/secrets/sa.json
# Логины и хэши паролей: python -m tcm.auth <пароль>
TCM_USERS=ceo:scrypt$...$...
# Случайная строка ≥32 символов: python -c "import secrets;print(secrets.token_hex(32))"
TCM_SECRET=
TCM_CACHE_MIN=15
TCM_COOKIE_SECURE=1
