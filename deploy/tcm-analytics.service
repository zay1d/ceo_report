# Вариант без Docker. Установка: см. CLAUDE.md, «Вариант Б».
[Unit]
Description=TCM Analytics (страница для руководства Tashkent City Mall)
After=network-online.target
Wants=network-online.target

[Service]
User=tcm
Group=tcm
WorkingDirectory=/opt/tcm-analytics/server
EnvironmentFile=/opt/tcm-analytics/.env
Environment=TCM_SA_KEY_FILE=/opt/tcm-analytics/secrets/sa.json
Environment=FORWARDED_ALLOW_IPS=127.0.0.1
ExecStart=/opt/tcm-analytics/venv/bin/uvicorn --factory tcm.app:create_app --host 127.0.0.1 --port 8000 --proxy-headers
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
